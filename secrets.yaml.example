# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is gitignored and must never be committed.

wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"
wifi_hotspot_password: "FallbackHotspotPassword"

# Generate with: openssl rand -base64 32
tesla_director_api_key: "your-32-character-encryption-key"
tesla_director_ota_password: "your-ota-password"

# Optional: only if you enable web_server auth: behind HTTPS (reverse proxy)
# or accept digest over a trusted LAN (see README).
# web_username: "admin"
# web_password: "your-web-password"
