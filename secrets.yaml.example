# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is gitignored and must never be committed.

wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"
wifi_hotspot_password: "FallbackHotspotPassword"

# Generate with: openssl rand -base64 32
tesla_director_api_key: "your-32-character-encryption-key"
tesla_director_ota_password: "your-ota-password"

# Optional: only if you enable web_server auth: behind HTTPS (reverse proxy)
# or accept digest over a trusted LAN (see README).
# web_username: "admin"
# web_password: "your-web-password"

# --- OCPP 1.6J PoC (feature/ocpp-1.6) ---
# Required only when ocpp_client.enabled: true.
# Prefer wss://. Lab may use ws:// with allow_cleartext_ws (RFC1918 only). Never commit real values.
ocpp_csms_url: "wss://ocpp.example.invalid/ocpp"
ocpp_charge_point_id: "CP001"
ocpp_authorization_key: "replace-me-unique-per-charge-point"

# Optional lab CA PEM for self-signed CSMS (preferred over allow_insecure_tls).
# ocpp_lab_ca_pem: |
#   -----BEGIN CERTIFICATE-----
#   ...
#   -----END CERTIFICATE-----
